{
  "version": 3,
  "configurePresets": [
    {
      "name": "host",
      "displayName": "Host build and portable tests",
      "binaryDir": "${sourceDir}/out/build/host",
      "cacheVariables": {
        "STEAMVR_GESTURE_EXIT_BUILD_TESTS": "ON",
        "STEAMVR_GESTURE_EXIT_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 Visual Studio build",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-x64",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/package/steamvr-gesture-exit",
        "STEAMVR_GESTURE_EXIT_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host",
      "configurePreset": "host"
    }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
